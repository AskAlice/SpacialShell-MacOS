# #149 media (docs/media/spatialisation): workspaces are rows, windows are cells. Real apps, each
# in the row its category sends it to (web, terminal, notes, TextEdit's two windows); Fn+S rides
# down the rows, Fn+D / Fn+A along the TextEdit row, Fn+W back up to where the loop started.
# Known state (#81): light, full-speed motion, no config file, no desktop widgets (their live
# clock and date show through the translucent panels), then a fresh shell.
appearance light
sh defaults delete sh.emu.SpacialShell SpacialMotionScale 2>/dev/null; rm -f ~/.config/spacial-shell/config.toml; true
sh defaults write com.apple.WindowManager StandardHideWidgets -bool true; killall WindowManager NotificationCenter 2>/dev/null; true
# The base image turns on Full Keyboard Access, which puts a focus ring on a layout button at random.
sh defaults write -g AppleKeyboardUIMode -int 0
# A flat desktop: a photo behind the translucent panels is most of every reference's bytes.
sh osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSWorkspace.sharedWorkspace.setDesktopImageURLForScreenOptionsError($.NSURL.fileURLWithPath("/System/Library/Desktop Pictures/Solid Colors/Stone.png"), $.NSScreen.mainScreen, $({}), null)'
relaunch
input move 700 520
# Not Calendar: it asks for notification permission in a banner that stays in every frame.
sh open -a Safari; sleep 2; open -a Terminal; sleep 2; open -a Notes; true
wait 8
# Notes opens on a first-run welcome window the first time (an earlier scenario may have been it).
input axclick pid:Notes Continue ?
wait 1
open 1 as a
open 1 as b
settle
focus a1
run set-layout-maximize
settle
run focus-workspace-1
settle
# One pass off camera: a switch's first capture in the GPU-less guest takes seconds.
input key fn-s
wait 2
input key fn-s
wait 2
input key fn-s
wait 2
input key fn-d
wait 2
input key fn-a
wait 2
input key fn-w
wait 2
input key fn-w
wait 2
input key fn-w
# Not `settle`: after this walk the state did not read the same twice within 10 s in the guest.
wait 3
input move 700 520
wait 1
record spatialisation 12 30
wait 0.8
input key fn-s
wait 1.05
input key fn-s
wait 1.05
input key fn-s
wait 1.05
input key fn-d
wait 1.05
input key fn-a
wait 1.05
input key fn-w
wait 1.05
input key fn-w
wait 1.05
input key fn-w
wait 1.5
