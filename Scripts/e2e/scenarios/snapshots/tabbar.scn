# The tab bar (#81): fit and equal sizing, overflow past the 88 pt floor (#14), and the layout
# switcher with each built-in layout selected (whole tiling area, so the layout shows too).
# Known state (#81): light, full-speed motion, no config file, no desktop widgets (their live
# clock and date show through the translucent panels), then a fresh shell.
appearance light
sh defaults delete sh.emu.SpacialShell SpacialMotionScale 2>/dev/null; rm -f ~/.config/spacial-shell/config.toml; true
sh defaults write com.apple.WindowManager StandardHideWidgets -bool true; killall WindowManager NotificationCenter 2>/dev/null; true
# The base image turns on Full Keyboard Access, which puts a focus ring on a layout button at random.
sh defaults write -g AppleKeyboardUIMode -int 0
# A flat desktop: a photo behind the translucent panels is most of every reference's bytes.
sh osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSWorkspace.sharedWorkspace.setDesktopImageURLForScreenOptionsError($.NSURL.fileURLWithPath("/System/Library/Desktop Pictures/Solid Colors/Stone.png"), $.NSScreen.mainScreen, $({}), null)'
relaunch
input move 600 400
# One instance per window, opened in turn, so the tab order is the same every run.
open 1 as a
open 1 as b
open 1 as c
settle
focus a1
settle
input move 600 400
wait 1
shot tabs-fit region=48,30,976,34 1x 0 thr=0

sh mkdir -p ~/.config/spacial-shell && printf 'tab-sizing = "equal"\n' > ~/.config/spacial-shell/config.toml
wait 2
settle
shot tabs-equal region=48,30,976,34 1x

run cycle-layout
settle
wait 1
shot layout-split region=0,30,1024,738 1x
run cycle-layout
settle
wait 1
shot layout-column region=0,30,1024,738 1x
run cycle-layout
settle
wait 1
shot layout-half region=0,30,1024,738 1x
run cycle-layout
settle
wait 1
shot layout-grid region=0,30,1024,738 1x
run cycle-layout
settle

sh rm -f ~/.config/spacial-shell/config.toml
wait 2
open 1 as d
open 1 as e
open 1 as f
open 1 as g
open 1 as h
open 1 as i
open 1 as j
open 1 as k
open 1 as l
settle
focus l1
settle
wait 1
shot tabs-overflow region=48,30,976,34 1x
